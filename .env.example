# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Opcional, SÓ para desenvolvimento: auto-login com uma conta de TESTE
# (crie em Authentication > Users > Add user, com "Auto Confirm User").
# Ignorado em builds de produção. Nunca use sua conta real aqui.
# VITE_DEV_LOGIN_EMAIL=dev@teste.local
# VITE_DEV_LOGIN_PASSWORD=uma-senha-de-teste
